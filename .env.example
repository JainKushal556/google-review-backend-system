# Groq API Key for AI review generation
GROQ_API_KEY=your_groq_api_key_here

# Secret Key for Security Token Signing
SECRET_KEY=change_this_to_random_secret_key

# Master Admin Password for Dashboard Access
ADMIN_PASSWORD=change_this_to_your_secure_password

# Optional: Supabase / PostgreSQL Connection String (falls back to local SQLite if empty)
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
